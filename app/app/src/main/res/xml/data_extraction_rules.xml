<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the Bannergress refresh token stays on the device -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bannergress.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bannergress.xml" />
    </device-transfer>
</data-extraction-rules>
