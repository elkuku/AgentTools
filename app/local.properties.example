# Copy to local.properties (git-ignored) and fill in.
sdk.dir=/path/to/Android/Sdk

# Web OAuth client ID from Google Cloud (the same value as OAUTH_GOOGLE_ID in web)
google.serverClientId=1234567890-abc.apps.googleusercontent.com

# Base URL of web. 10.0.2.2 is the host machine as seen from the emulator.
server.baseUrl.debug=http://10.0.2.2:8000
server.baseUrl.release=https://example.com

# Release signing: keystore outside the repo. Leave empty for an unsigned release build.
release.storeFile=/home/you/agenttools-release.jks
release.storePassword=
release.keyAlias=agenttools
release.keyPassword=

# Debug builds only: skip Google and send fake tokens for this identifier.
# Needs APP_FAKE_GOOGLE_TOKENS=1 in web/.env.local (dev env). Leave empty for real sign-in.
debug.fakeSignInEmail=
