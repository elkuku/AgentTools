# Copy to local.properties (git-ignored) and fill in.
sdk.dir=/path/to/Android/Sdk

# Web OAuth client ID from Google Cloud (the same value as OAUTH_GOOGLE_ID in upload-page)
google.serverClientId=1234567890-abc.apps.googleusercontent.com

# Base URL of upload-page. 10.0.2.2 is the host machine as seen from the emulator.
server.baseUrl.debug=http://10.0.2.2:8000
server.baseUrl.release=https://example.com
