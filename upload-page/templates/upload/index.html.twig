{% extends 'base.html.twig' %}

{% block title %}My uploads{% endblock %}

{% block body %}
    <h1>My uploads</h1>
    <div class="float-end">
        <a class="btn btn-outline-success" href="{{ path('app_upload_new') }}">Create new</a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Source</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for upload in uploads %}
            <tr>
                <td>{{ upload.id }}</td>
                <td>{{ upload.title }}</td>
                <td><span class="{{ upload.source.cssClass }}">{{ upload.source.label }}</span></td>
                <td>{{ upload.createdAt|date('Y-m-d H:i:s') }}</td>
                <td>
                    <a href="{{ path('app_upload_show', {'id': upload.id}) }}">show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
