{% extends 'base.html.twig' %}

{% block title %}Upload{% endblock %}

{% block body %}
    <h1 id="upload-title">{{ upload.title }}</h1>

    <div class="float-end">
        <a class="btn btn-outline-secondary" href="{{ path('app_upload_index') }}">back to list</a>
    </div>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ upload.id }}</td>
            </tr>
            <tr>
                <th>Source</th>
                <td><span class="{{ upload.source.cssClass }}">{{ upload.source.label }}</span></td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ upload.createdAt|date('Y-m-d H:i:s') }}</td>
            </tr>
        </tbody>
    </table>

    <h2 class="h4">Data</h2>
    <pre class="border rounded p-3"><code id="upload-data">{{ upload.data|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</code></pre>
{% endblock %}
