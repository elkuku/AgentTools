{# On every page of a non-production stage (APP_STAGE), e.g. the dev site; nothing in production.
   Fixed above the fixed navbar (see .stage-banner in app.css). #}
{% if stage %}
    <div class="stage-banner text-center fw-bold small px-2 text-truncate" role="status">
        {{ stage|upper }} · {{ ('stage.' ~ stage)|trans }}
    </div>
{% endif %}
