{% extends 'base.html.twig' %}

{% block title %}Agents{% endblock %}

{% block body %}
    <h1>Agents</h1>
    <p class="text-body-secondary">
        Agents who show their profile to other users. Choose what you show on your
        <a href="{{ path('app_profile') }}">profile</a>.
    </p>

    <table class="table table-sm align-middle" id="agents">
        <thead>
        <tr>
            <th>Agent</th>
            <th class="text-end">Level</th>
        </tr>
        </thead>
        <tbody>
        {# Space for a picture on every row when any agent shows one: the names line up #}
        {% set pictures = agents|filter(agent => agent.visibleAvatar)|length > 0 %}
        {% for agent in agents %}
            {% set stat = latest[agent.id] ?? null %}
            {% set faction = stat ? stat.factionCode %}
            <tr>
                <td>
                    {{ include('agent/_agent.html.twig', {picture: agent.visibleAvatar, link: true}) }}
                </td>
                {# On a span: Bootstrap's table cells set their own color #}
                <td class="text-end"><span class="fw-bold {{ faction ? 'faction-' ~ faction }}">{{ stat ? stat.level : '–' }}</span></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">No agent shows a profile yet.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
