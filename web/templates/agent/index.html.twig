{% extends 'base.html.twig' %}

{% block title %}Agents{% endblock %}

{% block body %}
    <h1>Agents</h1>
    <p class="text-body-secondary">
        Agents who show their profile to other users. Choose what you show on your
        <a href="{{ path('app_profile') }}">profile</a>.
    </p>

    <table class="table" id="agents">
        <thead>
        <tr>
            <th>Agent</th>
            <th>Faction</th>
            <th>Level</th>
        </tr>
        </thead>
        <tbody>
        {% for agent in agents %}
            {% set stat = latest[agent.id] ?? null %}
            <tr>
                <td><a href="{{ path('app_agent_show', {'agentName': agent.agentName}) }}">{{ agent.agentName }}</a></td>
                <td>{{ stat ? stat.faction : '–' }}</td>
                <td>{{ stat ? stat.level : '–' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">No agent shows a profile yet.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
