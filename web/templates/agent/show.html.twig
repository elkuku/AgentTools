{% extends 'base.html.twig' %}

{% block title %}{{ agent.agentName }}{% endblock %}

{% block body %}
    {% if isOwn %}
        <div class="alert alert-info mt-3">
            This is how other users see your profile. Change it on your <a href="{{ path('app_profile') }}">profile</a>.
        </div>
    {% endif %}

    {% if showLatestStats %}
        <div class="mt-3">
            {{ include('agent_stat/_stats_card.html.twig', {stat: latest}) }}
        </div>
    {% else %}
        {% set faction = latest ? latest.factionCode %}
        <h1 class="d-flex align-items-center gap-2">
            {% if faction %}
                <img class="faction-logo" src="{{ asset('images/logos/' ~ faction ~ '.svg') }}" alt="{{ faction }}" title="{{ latest.faction }}">
            {% endif %}
            <span id="agent-name" class="agent-nickname">{{ agent.agentName }}</span>
        </h1>
        {% if latest %}
            <p class="lead">{% if not faction %}{{ latest.faction }} &middot; {% endif %}<span class="fw-bold {{ faction ? 'faction-' ~ faction }}" id="agent-level">level {{ latest.level }}</span></p>
        {% endif %}
    {% endif %}

    {% if customMedals is not null %}
        <div class="mt-4">
            {{ include('agent_stat/_custom_medals.html.twig') }}
        </div>
    {% endif %}

    {% if history is not null %}
        <h2 class="h5 mt-4">Stats history</h2>
        <table class="table" id="stats-history">
            <thead>
            <tr>
                <th>Date</th>
                <th>Level</th>
                <th class="text-end">AP</th>
            </tr>
            </thead>
            <tbody>
            {% for stat in history %}
                <tr>
                    <td>{{ stat.datetime|date('Y-m-d H:i:s') }}</td>
                    <td>{{ stat.level }}</td>
                    <td class="text-end">{{ stat.ap|number_format }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">No stats yet.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
