{#
    An agent's timeline, read-only: the chart with the date filter and the entries.
    agent: User, timeline: list<TimelineEntry>, chart: TimelineChart|null
#}
{% extends 'base.html.twig' %}

{% block title %}{{ agent.agentName }} - {{ 'timeline.title'|trans }}{% endblock %}

{% block body %}
    <h1 id="timeline">
        <a href="{{ path('app_agent_show', {agentName: agent.agentName}) }}">{{ agent.agentName }}</a> &middot; {{ 'timeline.title'|trans }}
    </h1>

    {{ include('agent_stat/_timeline_chart_frame.html.twig') }}
    {{ include('agent_stat/_timeline.html.twig', {editable: false}) }}
{% endblock %}
