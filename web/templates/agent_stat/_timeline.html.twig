{#
    Stats uploads and custom events, newest first (App\Timeline\TimelineBuilder), as the app's timeline.
    timeline: list<TimelineEntry>, editable: bool (the own timeline: links to each upload, edit and delete events)
#}
<div data-controller="timeline-filter">
{% if timeline is not empty %}
    {# Filters in one row: what and when #}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="timeline-filters">
        {% for kind, icon in {upload: 'bi-bar-chart-line', event: 'bi-flag-fill', travel: 'bi-airplane-fill', banner: 'bi-grid-3x3-gap'}|filter((icon, kind) => kind != 'banner' or timeline|filter(e => e.banner)|length > 0) %}
            <input type="checkbox" class="btn-check" id="timeline-filter-{{ kind }}" value="{{ kind }}" checked autocomplete="off"
                   data-timeline-filter-target="kind" data-action="timeline-filter#apply">
            <label class="btn btn-sm btn-outline-secondary" for="timeline-filter-{{ kind }}">
                <i class="{{ icon }}"></i> {{ ('timeline.filter.' ~ kind)|trans }}
            </label>
        {% endfor %}
        {# Uploads only with a medal at a higher tier; events keep their own toggles #}
        <input type="checkbox" class="btn-check" id="timeline-filter-medals" autocomplete="off"
               data-timeline-filter-target="medals" data-action="timeline-filter#apply">
        <label class="btn btn-sm btn-outline-secondary" for="timeline-filter-medals">
            <i class="bi-award"></i> {{ 'timeline.filter.medals'|trans }}
        </label>
        <select class="form-select form-select-sm w-auto" id="timeline-filter-year" aria-label="{{ 'timeline.filter.year'|trans }}"
                data-timeline-filter-target="year" data-action="timeline-filter#apply">
            <option value="">{{ 'timeline.filter.all_years'|trans }}</option>
            {% for year in timeline_years(timeline) %}
                <option value="{{ year }}">{{ year }}</option>
            {% endfor %}
        </select>
    </div>
{% endif %}
<ol class="timeline list-unstyled" id="timeline-entries">
    {% for entry in timeline %}
        {% if entry.banner %}
            {% set banner = entry.banner %}
            <li class="timeline-entry timeline-banner" id="timeline-banner-{{ banner.id }}"
                data-timeline-filter-target="entry" data-kind="{{ entry.kind }}" data-years="{{ entry.years|join(' ') }}">
                <div class="timeline-date small text-body-secondary">{{ banner.doneAt|date('Y-m-d') }}</div>
                <div class="d-flex align-items-start gap-2">
                    <i class="bi-grid-3x3-gap timeline-banner-icon"></i>
                    <div class="flex-grow-1">
                        {{ 'bannergress.timeline_done'|trans }}
                        <a href="{{ banner.url }}" target="_blank" rel="noopener">{{ banner.title }}</a>
                        <span class="small text-body-secondary">&middot; {{ 'bannergress.missions'|trans({'%count%': banner.missions}) }}</span>
                        {% if banner.pictureUrl %}
                            <img class="d-block rounded mt-1 banner-picture" src="{{ banner.pictureUrl }}" alt="" loading="lazy">
                        {% endif %}
                    </div>
                    {% if editable %}
                        <a class="btn btn-sm btn-link py-0" href="{{ path('app_banners') }}#done-banner-{{ banner.id }}"
                           title="{{ 'action.edit'|trans }}" aria-label="{{ 'action.edit'|trans }}"><i class="bi-pencil"></i></a>
                    {% endif %}
                </div>
            </li>
        {% elseif entry.event %}
            {% set event = entry.event %}
            <li class="timeline-entry timeline-event" id="timeline-event-{{ event.id }}"
                data-timeline-filter-target="entry" data-kind="{{ entry.kind }}" data-years="{{ entry.years|join(' ') }}">
                <div class="timeline-date small text-body-secondary">
                    {{ event.date|date('Y-m-d') }}{% if event.endDate %} &ndash; {{ event.endDate|date('Y-m-d') }}{% endif %}
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i class="{{ event.endDate ? 'bi-airplane-fill timeline-travel-icon' : 'bi-flag-fill timeline-event-icon' }}"></i>
                    <div class="flex-grow-1 timeline-text">{{ event.text }}</div>
                    {% if editable %}
                        <a class="btn btn-sm btn-link py-0" href="{{ path('app_timeline_event_edit', {id: event.id}) }}"
                           title="{{ 'action.edit'|trans }}" aria-label="{{ 'action.edit'|trans }}"><i class="bi-pencil"></i></a>
                        <form method="post" action="{{ path('app_timeline_event_delete', {id: event.id}) }}"
                              onsubmit="return confirm('{{ 'timeline.event.confirm_delete'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-event' ~ event.id) }}">
                            <button class="btn btn-sm btn-link link-danger py-0" title="{{ 'action.delete'|trans }}"
                                    aria-label="{{ 'action.delete'|trans }}"><i class="bi-trash"></i></button>
                        </form>
                    {% endif %}
                </div>
            </li>
        {% else %}
            {% set stat = entry.stat %}
            {% set faction = stat.factionCode %}
            <li class="timeline-entry timeline-upload"
                data-timeline-filter-target="entry" data-kind="{{ entry.kind }}" data-years="{{ entry.years|join(' ') }}"
                {%- if entry.medalUps %} data-medals{% endif %}>
                <div class="timeline-date small text-body-secondary">
                    {% if editable %}
                        <a href="{{ path('app_agent_stat_show', {id: stat.id}) }}">{{ stat.datetime|date('Y-m-d H:i') }}</a>
                    {% else %}
                        {{ stat.datetime|date('Y-m-d H:i') }}
                    {% endif %}
                </div>
                <div>
                    <span class="fw-bold {{ faction ? 'faction-' ~ faction }}">L{{ stat.level ?? '–' }}</span>
                    &middot; {{ 'stats.ap'|trans({'%ap%': stat.ap|number_format}) }}
                    {% if entry.apGain > 0 %}<span class="text-success">+{{ entry.apGain|number_format }}</span>{% endif %}
                </div>
                {% if entry.first %}
                    <div class="small text-body-secondary">{{ 'timeline.first_upload'|trans }}</div>
                {% endif %}
                {% if entry.newLevel %}
                    <div class="fw-bold">{{ 'timeline.new_level'|trans({'%level%': entry.newLevel}) }}</div>
                {% endif %}
                {% if entry.recursions %}
                    <div class="d-flex align-items-center gap-1">
                        <img class="timeline-badge" src="{{ asset('badges/unique_badge_simulacrum.webp') }}" alt="" title="Simulacrum">
                        {{ 'timeline.recursion'|trans({'%count%': entry.recursions}) }}
                    </div>
                {% endif %}
                {% if entry.medalUps %}
                    <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                        {% for medal in entry.medalUps %}
                            <img class="timeline-badge" src="{{ asset(medal.badge) }}"
                                 alt="{{ medal.medal.name }}: {{ medal.levelName }}" title="{{ medal.medal.name }}: {{ medal.levelName }}">
                        {% endfor %}
                    </div>
                {% endif %}
            </li>
        {% endif %}
    {% else %}
        <li class="text-body-secondary">{{ 'stats.none'|trans }}</li>
    {% endfor %}
    <li class="text-body-secondary" id="timeline-filter-empty" data-timeline-filter-target="empty" hidden>{{ 'timeline.filter.none'|trans }}</li>
</ol>
</div>
