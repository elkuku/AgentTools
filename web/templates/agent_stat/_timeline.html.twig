{#
    Stats uploads and custom events, newest first (App\Timeline\TimelineBuilder), as the app's timeline:
    uploads only for what changed besides the AP (TimelineEntry::isListed(); the AP is in the chart). Each with its day in the
    page's language (medium: Oct 22, 2026 / 22.10.2026), without the time.
    The entries have no links (only the edit and delete buttons of the own timeline).
    timeline: list<TimelineEntry>, editable: bool (the own timeline: edit and delete events, change a banner's day)
#}
<div data-controller="timeline-filter">
{% set listed = timeline|filter(e => e.listed) %}
{% if listed is not empty %}
    {# Filters in one row, as the app's: uploads with medals or a new level (milestones always), each kind of event, the days #}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="timeline-filters">
        {% for filter, icon in {medals: 'bi-award', new_level: 'bi-graph-up-arrow'} %}
            <input type="checkbox" class="btn-check" id="timeline-filter-{{ filter|replace({'_': '-'}) }}" checked autocomplete="off"
                   data-timeline-filter-target="{{ filter == 'medals' ? 'medals' : 'newLevels' }}" data-action="timeline-filter#apply">
            <label class="btn btn-sm btn-outline-secondary" for="timeline-filter-{{ filter|replace({'_': '-'}) }}">
                <i class="{{ icon }}"></i> {{ ('timeline.filter.' ~ filter)|trans }}
            </label>
        {% endfor %}
        {% for kind, icon in {event: 'bi-flag-fill', travel: 'bi-airplane-fill', banner: 'bi-grid-3x3-gap'}|filter((icon, kind) => kind != 'banner' or listed|filter(e => e.banner)|length > 0) %}
            <input type="checkbox" class="btn-check" id="timeline-filter-{{ kind }}" value="{{ kind }}" checked autocomplete="off"
                   data-timeline-filter-target="kind" data-action="timeline-filter#apply">
            <label class="btn btn-sm btn-outline-secondary" for="timeline-filter-{{ kind }}">
                <i class="{{ icon }}"></i> {{ ('timeline.filter.' ~ kind)|trans }}
            </label>
        {% endfor %}
        {# Both days included; an empty one: no limit #}
        <div class="input-group input-group-sm w-auto">
            <label class="input-group-text" for="timeline-filter-from">{{ 'timeline.filter.from'|trans }}</label>
            <input type="date" class="form-control" id="timeline-filter-from"
                   data-timeline-filter-target="from" data-action="timeline-filter#apply">
            <label class="input-group-text" for="timeline-filter-to">{{ 'timeline.filter.to'|trans }}</label>
            <input type="date" class="form-control" id="timeline-filter-to"
                   data-timeline-filter-target="to" data-action="timeline-filter#apply">
        </div>
    </div>
{% endif %}
<ol class="timeline list-unstyled" id="timeline-entries">
    {% for entry in listed %}
        {% if entry.banner %}
            {% set banner = entry.banner %}
            <li class="timeline-entry timeline-banner{{ entry.inTravel ? ' timeline-in-travel' }}" id="timeline-banner-{{ banner.id }}"
                data-timeline-filter-target="entry" data-kind="{{ entry.kind }}" data-from="{{ entry.days[0] }}" data-to="{{ entry.days[1] }}">
                <div class="timeline-date small text-body-secondary">{{ banner.doneAt|format_date('medium') }}</div>
                <div class="d-flex align-items-start gap-2">
                    <i class="bi-grid-3x3-gap timeline-banner-icon"></i>
                    {# Collapsed: the picture (the missions' medals) when opened #}
                    {% set line %}
                        {{ 'bannergress.timeline_done'|trans }}
                        {{ banner.title }}
                        <span class="small text-body-secondary">&middot; {{ 'bannergress.missions'|trans({'%count%': banner.missions}) }}</span>
                    {% endset %}
                    {% if banner.pictureUrl %}
                        <details class="flex-grow-1 timeline-banner-details">
                            <summary>{{ line }}</summary>
                            <img class="d-block rounded mt-1 banner-picture" src="{{ banner.pictureUrl }}" alt="" loading="lazy">
                        </details>
                    {% else %}
                        <div class="flex-grow-1">{{ line }}</div>
                    {% endif %}
                    {% if editable %}
                        <a class="btn btn-sm btn-link py-0" href="{{ path('app_banners') }}#done-banner-{{ banner.id }}"
                           title="{{ 'action.edit'|trans }}" aria-label="{{ 'action.edit'|trans }}"><i class="bi-pencil"></i></a>
                    {% endif %}
                </div>
            </li>
        {% elseif entry.event %}
            {% set event = entry.event %}
            {# A travel twice: its end and its start, each with its day; a single-day event once #}
            {% set edge = entry.travelEdge %}
            <li class="timeline-entry timeline-event{{ edge ? ' timeline-travel timeline-travel-' ~ edge }}{{ entry.inTravel ? ' timeline-in-travel' }}"
                id="timeline-event-{{ event.id }}{{ edge == 'end' ? '-end' }}"
                data-timeline-filter-target="entry" data-kind="{{ entry.kind }}" data-from="{{ entry.days[0] }}" data-to="{{ entry.days[1] }}">
                <div class="timeline-date small text-body-secondary">
                    {{ (edge == 'end' ? event.endDate : event.date)|format_date('medium') }}
                    {% if edge %}&middot; {{ ('timeline.travel.' ~ edge)|trans }}{% endif %}
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i class="{{ edge ? 'bi-airplane-fill timeline-travel-icon' : 'bi-flag-fill timeline-event-icon' }}"></i>
                    <div class="flex-grow-1 timeline-text">{{ event.text }}</div>
                    {% if editable %}
                        <a class="btn btn-sm btn-link py-0" href="{{ path('app_timeline_event_edit', {id: event.id}) }}"
                           title="{{ 'action.edit'|trans }}" aria-label="{{ 'action.edit'|trans }}"><i class="bi-pencil"></i></a>
                        <form method="post" action="{{ path('app_timeline_event_delete', {id: event.id}) }}"
                              onsubmit="return confirm('{{ 'timeline.event.confirm_delete'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-event' ~ event.id) }}">
                            <button class="btn btn-sm btn-link link-danger py-0" title="{{ 'action.delete'|trans }}"
                                    aria-label="{{ 'action.delete'|trans }}"><i class="bi-trash"></i></button>
                        </form>
                    {% endif %}
                </div>
            </li>
        {% else %}
            {% set stat = entry.stat %}
            <li class="timeline-entry timeline-upload{{ entry.inTravel ? ' timeline-in-travel' }}"
                data-timeline-filter-target="entry" data-kind="{{ entry.kind }}" data-from="{{ entry.days[0] }}" data-to="{{ entry.days[1] }}"
                {%- if entry.milestone %} data-milestone{% endif %}
                {%- if entry.medalUps %} data-medals{% endif %}
                {%- if entry.newLevel %} data-new-level{% endif %}>
                <div class="timeline-date small text-body-secondary">{{ stat.datetime|format_date('medium') }}</div>
                {# Level and AP are in the chart; the list shows only what changed #}
                {% if entry.first %}
                    <div class="small text-body-secondary">{{ 'timeline.first_upload'|trans }}</div>
                {% endif %}
                {% if entry.newLevel %}
                    <div class="fw-bold">{{ 'timeline.new_level'|trans({'%level%': entry.newLevel}) }}</div>
                {% endif %}
                {% if entry.recursions %}
                    <div class="d-flex align-items-center gap-1">
                        <img class="timeline-badge" src="{{ asset('badges/unique_badge_simulacrum.webp') }}" alt="" title="Simulacrum">
                        {{ 'timeline.recursion'|trans({'%count%': entry.recursions}) }}
                    </div>
                {% endif %}
                {% if entry.medalUps %}
                    <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                        {% for medal in entry.medalUps %}
                            <img class="timeline-badge" src="{{ asset(medal.badge) }}"
                                 alt="{{ medal.medal.name }}: {{ medal.levelName }}" title="{{ medal.medal.name }}: {{ medal.levelName }}">
                        {% endfor %}
                    </div>
                {% endif %}
            </li>
        {% endif %}
    {% else %}
        <li class="text-body-secondary">{{ 'stats.none'|trans }}</li>
    {% endfor %}
    <li class="text-body-secondary" id="timeline-filter-empty" data-timeline-filter-target="empty" hidden>{{ 'timeline.filter.none'|trans }}</li>
</ol>
</div>
