{% extends 'base.html.twig' %}

{% block title %}{{ 'stats.mine'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'stats.mine'|trans }}</h1>

    {% if latest %}
        <div class="mt-3">
            {{ include('agent_stat/_stats_card.html.twig', {stat: latest, avatar: app.user.avatar}) }}
        </div>
    {% endif %}

    <div class="mt-4">
        {{ include('agent_stat/_custom_medals.html.twig') }}
    </div>

    <h2 class="h5 mt-4">{{ 'stats.all_imports'|trans }}</h2>
    <table class="table">
        <thead>
        <tr>
            <th>{{ 'stats.date'|trans }}</th>
            <th>{{ 'stats.agent'|trans }}</th>
            <th>{{ 'stats.level'|trans }}</th>
            <th class="text-end">AP</th>
            <th>{{ 'action.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for agent_stat in agent_stats %}
            <tr>
                <td>{{ agent_stat.datetime|date('Y-m-d H:i:s') }}</td>
                <td>{{ agent_stat.nickname }} <span class="text-secondary">({{ agent_stat.faction }})</span></td>
                <td>{{ agent_stat.level }}</td>
                <td class="text-end">{{ agent_stat.ap|number_format }}</td>
                <td>
                    <a href="{{ path('app_agent_stat_show', {'id': agent_stat.id}) }}">{{ 'action.show'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">{{ 'action.no_records'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
