{% extends 'base.html.twig' %}

{% block title %}{{ 'stats.mine'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'stats.mine'|trans }}</h1>

    {% if latest %}
        <div class="mt-3">
            {{ include('agent_stat/_stats_card.html.twig', {stat: latest, avatar: app.user.avatar}) }}
        </div>
    {% endif %}

    <div class="mt-4">
        {{ include('agent_stat/_custom_medals.html.twig') }}
    </div>

    <div class="mt-4">
        {{ include('agent_stat/_banners.html.twig', {url: path('app_banners')}) }}
    </div>

    <h2 class="h5 mt-4" id="timeline">{{ 'timeline.title'|trans }}</h2>
    {% if chart %}{{ include('agent_stat/_timeline_chart.html.twig') }}{% endif %}
    <details class="card mb-3" id="timeline-add"{% if eventForm.vars.submitted %} open{% endif %}>
        <summary class="card-header"><i class="bi-flag"></i> {{ 'timeline.event.add'|trans }}</summary>
        <div class="card-body">
            {{ form_start(eventForm, {action: path('app_agent_stat_index') ~ '#timeline'}) }}
                <div class="row">
                    <div class="col-sm-6">{{ form_row(eventForm.date) }}</div>
                    <div class="col-sm-6">{{ form_row(eventForm.endDate) }}</div>
                </div>
                {{ form_row(eventForm.text) }}
                <button class="btn btn-primary">{{ 'timeline.event.add'|trans }}</button>
            {{ form_end(eventForm) }}
        </div>
    </details>
    {{ include('agent_stat/_timeline.html.twig', {editable: true}) }}
{% endblock %}
