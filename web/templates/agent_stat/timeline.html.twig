{% extends 'base.html.twig' %}

{% block title %}{{ 'timeline.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h1 id="timeline">{{ 'timeline.title'|trans }}</h1>
        <div class="d-flex gap-2">
            {# A link, not a button: the modal's own button submits it #}
            <a class="btn btn-primary" role="button" href="#timeline-add" data-bs-toggle="modal" id="timeline-add-open">
                <i class="bi-plus-lg"></i> {{ 'timeline.event.add'|trans }}
            </a>
            <a class="btn btn-outline-secondary" href="{{ path('app_agent_stat_index') }}">{{ 'stats.mine'|trans }}</a>
        </div>
    </div>

    {{ include('agent_stat/_timeline_chart_frame.html.twig') }}

    {# Opens again with the errors of a submitted form #}
    <div class="modal fade" id="timeline-add" tabindex="-1" aria-labelledby="timeline-add-title" aria-hidden="true"
         data-controller="modal" data-modal-open-value="{{ eventForm.vars.submitted ? 'true' : 'false' }}">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                {{ form_start(eventForm, {action: path('app_agent_stat_timeline')}) }}
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="timeline-add-title"><i class="bi-flag"></i> {{ 'timeline.event.add'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'action.close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-sm-6">{{ form_row(eventForm.date) }}</div>
                            <div class="col-sm-6">{{ form_row(eventForm.endDate) }}</div>
                        </div>
                        {{ form_row(eventForm.text) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'action.cancel'|trans }}</button>
                        <button class="btn btn-primary">{{ 'timeline.event.add'|trans }}</button>
                    </div>
                {{ form_end(eventForm) }}
            </div>
        </div>
    </div>
    {{ include('agent_stat/_timeline.html.twig', {editable: true}) }}
{% endblock %}
