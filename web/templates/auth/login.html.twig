{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ 'login.title'|trans }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://accounts.google.com/gsi/client" async defer></script>
{% endblock %}

{% block body %}
    <div class="row justify-content-center py-5">
        <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card login-card shadow-sm">
                <div class="card-body p-4 p-sm-5 text-center">
                    <img src="{{ asset('favicon.svg') }}" alt="" width="88" height="88" class="landing-icon rounded-4 mb-4">
                    <h1 class="h3 fw-bold mb-2">{{ 'login.title'|trans }}</h1>
                    <p class="text-body-secondary mb-4">{{ 'login.lead'|trans }}</p>

                    {% if error %}
                        <div class="alert alert-danger text-start">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <div id="g_id_onload"
                         data-client_id="{{ oauthGoogleId }}"
                         data-login_uri="{{ url('connect_google_verify') }}"
                         data-auto_prompt="false">
                    </div>
                    <div class="d-flex justify-content-center login-google">
                        <div class="g_id_signin"
                             data-controller="google-button"
                             data-type="standard"
                             data-size="large"
                             data-theme="outline"
                             data-text="sign_in_with"
                             data-shape="pill"
                             data-logo_alignment="left"
                             data-width="280"
                             data-locale="{{ app.request.locale }}">
                        </div>
                    </div>

                    <hr class="my-4">

                    <p class="small text-body-secondary mb-2">
                        <i class="bi-shield-lock landing-accent"></i> {{ 'login.privacy'|trans }}
                    </p>
                    <p class="small text-body-secondary mb-0">
                        {{ 'login.no_app'|trans({'%url%': 'https://github.com/elkuku/AgentTools/releases/latest'})|raw }}
                    </p>
                </div>
            </div>

            {% if 'dev' == app.environment %}
                <div class="card login-dev mt-4">
                    <div class="card-body">
                        <h2 class="h6 text-body-secondary"><i class="bi-wrench"></i> {{ 'login.dev'|trans }}</h2>
                        <form method="post" action="{{ path('app_login') }}">
                            <div class="input-group">
                                <input class="form-control" id="identifier" name="identifier" placeholder="{{ 'user.identifier'|trans }}"
                                       aria-label="{{ 'user.identifier'|trans }}" value="{{ last_username }}" required>
                                <button type="submit" class="btn btn-primary">{{ 'login.title'|trans }}</button>
                            </div>
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('login') }}">
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
