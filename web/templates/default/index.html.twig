{% extends 'base.html.twig' %}

{% block body %}
    {% if app.user %}
        <div class="alert alert-success mt-4">
            <h4>{{ 'home.welcome'|trans({'%name%': app.user.agentName ?: app.user.userIdentifier}) }}</h4>
            {{ 'home.see_your_stats'|trans({'%url%': path('app_agent_stat_index')})|raw }}
        </div>
    {% endif %}

    <section class="landing-hero text-center py-5">
        <img src="{{ asset('favicon.svg') }}" alt="{{ 'home.icon_alt'|trans }}" width="128" height="128" class="landing-icon rounded-4 mb-4">
        <h2 class="display-5 fw-bold landing-title">AgentTools</h2>
        <p class="lead col-lg-8 mx-auto text-body-secondary">
            {{ 'home.lead'|trans|raw }}
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a class="btn btn-success btn-lg" href="https://github.com/elkuku/AgentTools/releases/latest">
                <i class="bi-android2"></i> {{ 'home.download'|trans }}
            </a>
            {% if app.user %}
                <a class="btn btn-outline-primary btn-lg" href="{{ path('app_agent_stat_index') }}">
                    <i class="bi-bar-chart-line"></i> {{ 'home.my_stats'|trans }}
                </a>
            {% else %}
                <a class="btn btn-outline-primary btn-lg" href="{{ path('app_login') }}">
                    <i class="bi-box-arrow-in-right"></i> {{ 'home.sign_in'|trans }}
                </a>
            {% endif %}
        </div>
        <p class="small text-body-secondary mt-3">{{ 'home.requirements'|trans|raw }}</p>
    </section>

    <section class="py-4">
        <h3 class="mb-4"><i class="bi-phone landing-accent"></i> {{ 'home.app.title'|trans }}</h3>
        <div class="row g-4">
            {% for feature, icon in {share: 'bi-share', changes: 'bi-graph-up-arrow', medals: 'bi-award', custom_medals: 'bi-images'} %}
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 landing-feature">
                        <div class="card-body">
                            <i class="{{ icon }} fs-2 landing-accent"></i>
                            <h5 class="card-title mt-2">{{ ('home.app.' ~ feature ~ '.title')|trans }}</h5>
                            <p class="card-text">{{ ('home.app.' ~ feature ~ '.text')|trans|raw }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="py-4">
        <h3 class="mb-4"><i class="bi-globe landing-accent"></i> {{ 'home.web.title'|trans }}</h3>
        <div class="row g-4">
            {% for feature, icon in {stats: 'bi-table', private: 'bi-shield-check', api: 'bi-braces'} %}
                <div class="col-md-4">
                    <div class="card h-100 landing-feature">
                        <div class="card-body">
                            <i class="{{ icon }} fs-2 landing-accent"></i>
                            <h5 class="card-title mt-2">{{ ('home.web.' ~ feature ~ '.title')|trans }}</h5>
                            <p class="card-text">{{ ('home.web.' ~ feature ~ '.text')|trans({'%api_docs%': path('api_doc')})|raw }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="py-4 mb-4">
        <h3 class="mb-4"><i class="bi-rocket-takeoff landing-accent"></i> {{ 'home.start.title'|trans }}</h3>
        <ol class="list-group list-group-numbered">
            {% for step in ['install', 'sign_in', 'share', 'see'] %}
                <li class="list-group-item">
                    {{ ('home.start.' ~ step)|trans({'%release%': 'https://github.com/elkuku/AgentTools/releases/latest'})|raw }}
                </li>
            {% endfor %}
        </ol>
    </section>
{% endblock %}
