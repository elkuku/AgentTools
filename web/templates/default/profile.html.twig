{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - User Profile{% endblock %}

{% block body %}
    <h1>User Profile</h1>

    {% if app.user.avatar %}
        <img class="avatar mb-3" src="{{ app.user.avatar }}" alt="Profile picture" width="100" height="100" id="avatar">
    {% endif %}

    <p>Identifier: <code>{{ app.user.userIdentifier }}</code></p>
    <p>
        Agent name:
        {% if app.user.agentName %}
            <code>{{ app.user.agentName }}</code>
        {% else %}
            not set yet. Your first stats upload sets it, or set it in the app's settings: only stats for
            this agent are accepted.
        {% endif %}
    </p>

    <h2 class="mt-5">Visibility</h2>
    {% if not app.user.visibilityChosenAt %}
        <div class="alert alert-info" id="visibility-not-chosen">
            Choose what other users may see of your profile. Until you save, everything is private.
        </div>
    {% endif %}
    {{ form_start(visibilityForm) }}
        <fieldset class="mb-3">
            <legend class="col-form-label">{{ visibilityForm.visibleParts.vars.label }}</legend>
            {% for part in visibilityForm.visibleParts %}
                <div class="mb-2">
                    {{ form_widget(part) }}
                    <div class="form-text ms-4 mt-0">{{ partHelp[part.vars.value] }}</div>
                </div>
            {% endfor %}
            <div class="form-text">{{ visibilityForm.visibleParts.vars.help }}</div>
            {{ form_errors(visibilityForm.visibleParts) }}
        </fieldset>
        <button type="submit" class="btn btn-primary">Save</button>
        {% if agentPageVisible %}
            <a class="btn btn-outline-secondary" href="{{ path('app_agent_show', {'agentName': app.user.agentName}) }}">
                See your agent page
            </a>
        {% endif %}
    {{ form_end(visibilityForm) }}

    {% if is_granted('ROLE_ADMIN') %}
        <h2 class="mt-5">API token</h2>
        {% if apiToken %}
            <p>
                Paste it in the <a href="{{ path('api_doc') }}">API docs</a> under <strong>Authorize</strong>.
                {% if apiToken.fake %}
                    A fake dev token (<code>APP_FAKE_GOOGLE_TOKENS</code>), it does not expire.
                {% elseif apiToken.expiresAt %}
                    Valid until {{ apiToken.expiresAt|date('Y-m-d H:i') }}; sign in with Google again for a new one.
                {% endif %}
            </p>
            <div class="input-group" data-controller="clipboard">
                <input type="text" class="form-control font-monospace" id="api-token" name="api-token" value="{{ apiToken.token }}"
                       readonly aria-label="API token" data-clipboard-target="source">
                <button type="button" class="btn btn-outline-secondary" data-action="clipboard#copy"
                        data-clipboard-target="button">Copy</button>
            </div>
        {% else %}
            <p>
                Sign out and sign in with Google to get a token for the <a href="{{ path('api_doc') }}">API docs</a>.
                Only a Google sign-in has one, and it is valid for about an hour.
            </p>
        {% endif %}
    {% endif %}

{% endblock %}


