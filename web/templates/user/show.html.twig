{% extends 'base.html.twig' %}

{% block title %}{{ 'stats.agent'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'stats.agent'|trans }}</h1>

<div class="btn-group float-end" role="group">
    <a class="btn btn-outline-secondary" href="{{ path('app_user_index') }}">{{ 'action.back_to_list'|trans }}</a>

    <a class="btn btn-outline-warning" href="{{ path('app_user_edit', {'id': user.id}) }}">{{ 'action.edit'|trans }}</a>

    {{ include('user/_delete_form.html.twig') }}
</div>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>{{ 'user.identifier'|trans }}</th>
                <td>{{ user.identifier }}</td>
            </tr>
            <tr>
                <th>{{ 'user.role'|trans }}</th>
                <td>{{ user.role.label|trans }}</td>
            </tr>
            <tr>
                <th>{{ 'user.agent_name'|trans }}</th>
                <td>{{ user.agentName }}</td>
            </tr>
            <tr>
                <th>Params</th>
                <td>{{ user.params ? user.params|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>GoogleId</th>
                <td>{{ user.googleId }}</td>
            </tr>
        </tbody>
    </table>

{% endblock %}
